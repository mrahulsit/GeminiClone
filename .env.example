# ──────────────────────────────────────────────────────────────
# Copy to .env and fill in real values.  .env is gitignored.
# ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001

# ── Frontend API base (leave blank in prod → same-origin) ──
VITE_API_URL=

# ── CORS (comma-separated origins, blank = allow all) ──────
# CORS_ORIGIN=https://yourdomain.com

# ── Neon Postgres ──────────────────────────────────────────
NEON_BRANCH=production
DATABASE_URL=postgresql://username:password@ep-...?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://username:password@ep-...?sslmode=require
NEON_AUTH_BASE_URL=https://ep-....neonauth.../neondb/auth
NEON_AUTH_JWKS_URL=https://ep-....neonauth.../neondb/auth/.well-known/jwks.json

# ── Auth (generate with: openssl rand -base64 48) ──────────
JWT_SECRET=

# ── Google AI Studio ───────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# GEMINI_IMAGE_MODEL=imagen-4.0-generate-001

# ── Optional: Tavily web search ────────────────────────────
# TAVILY_API_KEY=
